<?xml version="1.0" encoding="utf-8"?>
<!--
  The staging flavour reads its network rule from the file the build generates
  from network-security/staging.xml (epic 61, design decision D12), not from the
  main one, so plain HTTP reaches the staging backend's host only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config_staging"
        tools:replace="android:networkSecurityConfig" />

</manifest>
