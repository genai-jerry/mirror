<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirror keeps nothing worth carrying to another phone: camera images are
  never written to disk, and the only stored setting is the chosen language
  pair. Nothing is backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
